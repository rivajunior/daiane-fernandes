{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "react-router.config.ts",
    "scripts",
    "app/headers.ts",
    "app/defer-hydration.ts",
    "app/inline-script-hashes.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "types": ["node"],
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
