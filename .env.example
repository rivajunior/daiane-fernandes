# Public site URL, no trailing slash (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:5173
# Digits only, country code included (placeholder)
WHATSAPP_NUMBER=5585900000000
# Optional: Cloudflare Web Analytics site token; analytics stays off when empty
CF_WEB_ANALYTICS_TOKEN=
# Set to true only when the real domain goes live (otherwise noindex + Disallow)
ALLOW_INDEXING=false
# Required: professional registration number, shown in the footer and structured data
CRN=CRN-0 00000

