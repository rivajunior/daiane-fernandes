{
  "name": "daiane-fernandes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/generate-headers.ts",
    "dev": "react-router dev",
    "typecheck": "wrangler types .wrangler/worker-configuration.d.ts && react-router typegen && tsc -b",
    "deploy": "vp run build && wrangler deploy",
    "preview": "vp run build && vp preview",
    "cf-typegen": "mkdir -p .wrangler && wrangler types .wrangler/worker-configuration.d.ts",
    "postinstall": "vp run cf-typegen",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "prepare": "vp config"
  },
  "dependencies": {
    "isbot": "^5.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@cloudflare/vite-plugin": "^1.70.2",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^8.5.3",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-playwright": "^2.12.2",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.168.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  }
}
