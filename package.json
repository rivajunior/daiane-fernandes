{
  "name": "daiane-fernandes",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build && node scripts/generate-headers.ts",
    "dev": "react-router dev",
    "typecheck": "wrangler types .wrangler/worker-configuration.d.ts && react-router typegen && tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && vp preview",
    "cf-typegen": "mkdir -p .wrangler && wrangler types .wrangler/worker-configuration.d.ts",
    "postinstall": "vp run cf-typegen",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp lint",
    "format": "vp fmt",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "prepare": "vp config"
  },
  "dependencies": {
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.151.1"
  }
}
